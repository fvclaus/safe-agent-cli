#!/bin/bash
LOG=/tmp/bwrap-wrapper.log
printf '[%s] called with: %s\n' "$(date -Iseconds)" "$*" >> "$LOG"
args=()
for a in "$@"; do
  if [ "$a" = "--unshare-net" ]; then
    printf '[%s] stripped: --unshare-net\n' "$(date -Iseconds)" >> "$LOG"
  else
    args+=("$a")
  fi
done
printf '[%s] exec: %s %s\n' "$(date -Iseconds)" "$REAL_BWRAP" "${args[*]}" >> "$LOG"
exec "$REAL_BWRAP" "${args[@]}"
