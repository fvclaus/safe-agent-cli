#!/usr/bin/env bun
/**
 * bwrap shim — intercepts Claude Code's sandbox invocations before they reach the
 * real bwrap. The launcher puts this file on PATH ahead of the genuine bwrap and
 * points REAL_BWRAP at the real one (see src/adapters/claude-code.ts).
 *
 * This file is the thin I/O layer: it reads argv/env, probes the filesystem, and
 * execs the real bwrap. All argument-transformation logic lives in (and is
 * unit-tested through) ./bwrap-transform.ts:
 *
 *   1. Strip `--unshare-net` so the sandbox shares the host network namespace,
 *      making processes the agent starts (e.g. a dev server) reachable.
 *   2. Fix Claude Code's proxy-cleanup trap so it preserves the real exit code.
 *   3. Inject the missing gitdir binds when the project is a git worktree.
 *   4. Honor `sandbox.filesystem.allowWrite` from the Claude settings files,
 *      overriding the harness's hardcoded .claude/.git/dotfile deny wall.
 *
 * git-sandboxed (a built-in helper the agent can call) needs no wiring here:
 * it lives directly in this same directory, which is already on PATH and
 * already bind-mounted (this whole repo is) — see buildSpawnEnv in
 * src/adapters/claude-code.ts. An earlier version of this file bind-mounted
 * a separate tools/ directory and injected a --setenv PATH for it, but
 * Claude Code re-sources a frozen shell-snapshot PATH inside every sandboxed
 * command, which clobbers any PATH bwrap itself is told to set — so that
 * approach never actually worked. Living inside the already-on-PATH src/bin
 * sidesteps the problem entirely.
 */
import { spawnSync } from 'node:child_process';
import { appendFileSync, existsSync, readFileSync, realpathSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import {
  appendWritableRebinds,
  discoverProjectRoot,
  injectWorktreeBinds,
  isWithin,
  resolveSettingsPath,
  stripDenyWall,
  stripUnshareNetAndFixTrap,
  type WorktreeProbe,
} from './bwrap-transform.js';

const REAL_BWRAP = process.env['REAL_BWRAP'] || '/usr/bin/bwrap';
const DEBUG = Boolean(process.env['BWRAP_WRAPPER_DEBUG']);
const LOG = '/tmp/bwrap-wrapper.log';
const HOME = process.env['HOME'] ?? '';

// A misdetected REAL_BWRAP pointing back at this very script (e.g. a caller finding
// "bwrap" on PATH via a naive `which bwrap` when this shim's own directory is already
// ahead of the real binary — see src/real-bwrap.ts) would otherwise exec into itself:
// each recursive pass re-applies the transforms below and appends more args on top of
// the last pass's already-transformed list, growing without bound until it exhausts
// memory or hits the OS argv-length limit. Fail loudly instead of recursing.
try {
  if (realpathSync(REAL_BWRAP) === fileURLToPath(new URL(import.meta.url))) {
    console.error(
      `bwrap shim: REAL_BWRAP ("${REAL_BWRAP}") resolves to this same shim script — ` +
      'refusing to exec into itself (this would recurse and grow its argument list ' +
      'without bound). This means whatever set REAL_BWRAP found this shim on PATH ' +
      'instead of the genuine bubblewrap binary — see src/real-bwrap.ts.',
    );
    process.exit(1);
  }
} catch {
  // REAL_BWRAP not resolvable (e.g. missing) — let the real spawnSync below report it.
}

function debugLog(line: string): void {
  if (!DEBUG) return;
  try {
    appendFileSync(LOG, `[${new Date().toISOString()}] ${line}\n`);
  } catch {
    /* best-effort logging only */
  }
}

// ── 1 & 2. Strip --unshare-net and fix the exit-code-eating trap ────────────────
let args = stripUnshareNetAndFixTrap(process.argv.slice(2));

// ── 3. Inject worktree gitdir binds ─────────────────────────────────────────────
const worktreeProbe: WorktreeProbe = {
  isPointerFile: (src) => existsSync(src) && statSync(src).isFile(),
  readPointer: (src) => readFileSync(src, 'utf8'),
};
args = injectWorktreeBinds(args, worktreeProbe);

// ── 4. Honor allowWrite by removing the harness's deny wall selectively ──────────
const projectRoot = discoverProjectRoot(args, process.cwd());

function readFilesystemArray(file: string, key: 'allowWrite' | 'denyWrite'): string[] {
  try {
    const parsed = JSON.parse(readFileSync(file, 'utf8')) as {
      sandbox?: { filesystem?: Record<string, unknown> };
    };
    const arr = parsed?.sandbox?.filesystem?.[key];
    return Array.isArray(arr) ? (arr as string[]) : [];
  } catch {
    return [];
  }
}

const writePrefixes: string[] = [];
const denyPrefixes: string[] = [];
for (const file of [
  join(HOME, '.claude', 'settings.json'),
  join(projectRoot, '.claude', 'settings.json'),
  join(projectRoot, '.claude', 'settings.local.json'),
]) {
  if (!existsSync(file)) continue;
  for (const p of readFilesystemArray(file, 'allowWrite')) {
    const r = resolveSettingsPath(p, projectRoot, HOME);
    if (r) writePrefixes.push(r);
  }
  for (const p of readFilesystemArray(file, 'denyWrite')) {
    const r = resolveSettingsPath(p, projectRoot, HOME);
    if (r) denyPrefixes.push(r);
  }
}

args = stripDenyWall(args, writePrefixes, denyPrefixes, (dest) => debugLog(`undeny: ${dest}`));

// Re-bind whitelisted paths read-write after the deny wall so they win over any
// ancestor deny (e.g. allowWrite ".claude/hooks/.venv" under a denied
// ".claude/hooks"). Only bind paths that exist and aren't re-denied — bwrap fails
// to bind a missing source.
const rebindable = writePrefixes.filter(
  (p) => existsSync(p) && !isWithin(p, denyPrefixes),
);
args = appendWritableRebinds(args, rebindable, (p) => debugLog(`rebind: ${p}`));

// ── Exec the real bwrap ─────────────────────────────────────────────────────────
// The old bash shim used `exec`, which preserves every inherited file descriptor.
// spawnSync only wires up stdio (0-2) by default, but Claude Code passes the
// seccomp filter program on an inherited fd (the sandboxed command runs
// `ARGV0=apply-seccomp /proc/self/fd/3 …`). Forward the inherited fds to the same
// numbers so bwrap — and the process it launches — still see them.
//
// Probe /proc/self/fd/<n> with existsSync rather than readdir: enumerating the
// directory would open a transient fd that is closed again before spawnSync runs,
// and forwarding that stale number as an integer would fail with EBADF.
const stdio: Array<'inherit' | 'ignore' | number> = ['inherit', 'inherit', 'inherit'];
for (let fd = 3; fd <= 20; fd++) {
  stdio[fd] = existsSync(`/proc/self/fd/${fd}`) ? fd : 'ignore';
}
while (stdio.length > 3 && stdio[stdio.length - 1] === 'ignore') stdio.pop();

debugLog(`exec: ${REAL_BWRAP} ${args.join(' ')}`);

const result = spawnSync(REAL_BWRAP, args, { stdio });
if (result.error) {
  console.error(result.error);
  process.exit(127);
}
if (result.signal) {
  // Re-raise so the parent sees the same termination signal.
  process.kill(process.pid, result.signal);
}
process.exit(result.status ?? 0);
