#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

# bun strips the first `--` after the script path; pass one explicitly so a
# user-supplied leading `--` (the agent-args separator) survives.
exec bun --no-env-file "${REPO_ROOT}/src/commands/codex.tsx" -- "$@"
