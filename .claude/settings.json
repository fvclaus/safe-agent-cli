{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/*)",
      "Edit(/*)"
    ],
    "deny": []
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "."
      ],
      "allowRead": [
        "."
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // \"\"'); case \"$f\" in *.ts|*.tsx|*.mts|*.cts) bun run typecheck 2>&1;; esac",
            "statusMessage": "Type checking…"
          }
        ]
      }
    ]
  }
}
